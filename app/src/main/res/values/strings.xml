    <!-- Education tips - titles and categories (need K'iche' translations) -->
    <string name="tip_50_30_20_title">Regla del 50/30/20</string>
    <string name="tip_50_30_20_category">Presupuesto</string>
    <string name="tip_50_30_20_content">Divide tus ingresos: 50% necesidades (vivienda, comida, transporte), 30% deseos (entretenimiento, compras), 20% ahorro e inversiones. Ajusta según tu realidad guatemalteca.</string>
    <string name="tip_emergency_fund_title">Fondo de Emergencia</string>
    <string name="tip_emergency_fund_category">Seguridad</string>
    <string name="tip_emergency_fund_content">Mantén 3-6 meses de gastos básicos en una cuenta separada y accesible. En Guatemala, considera Q15,000-Q30,000 como base para imprevistos médicos, reparaciones o pérdida de empleo.</string>
    <string name="tip_compound_interest_title">Interés Compuesto</string>
    <string name="tip_compound_interest_category">Inversión</string>
    <string name="tip_compound_interest_content">El interés compuesto hace que tus ganancias generen más ganancias. Empezar temprano es clave: Q500/mes al 8% anual = Q294,000 en 20 años vs Q73,000 en 10 años. El tiempo es tu mejor aliado.</string>
    <string name="tip_diversification_title">Diversificación</string>
    <string name="tip_diversification_category">Riesgo</string>
    <string name="tip_diversification_content">No pongas todos los huevos en la misma canasta. Diversifica: efectivo, certificados de depósito, bonos, acciones, bienes raíces. En Guatemala: bancas, cooperativas, fondos de inversión, propiedades.</string>
    <string name="tip_investment_horizon_title">Horizonte de Inversión</string>
    <string name="tip_investment_horizon_category">Planificación</string>
    <string name="tip_investment_horizon_content">Tu horizonte temporal determina el riesgo: Corto plazo (0-3 años) = conservador (depósitos, bonos). Mediano (3-7 años) = mixto. Largo plazo (7+ años) = puede asumir más riesgo (acciones, fondos).</string>
    <string name="tip_smart_debt_title">Deuda Inteligente</string>
    <string name="tip_smart_debt_category">Deuda</string>
    <string name="tip_smart_debt_content">Diferencia deuda buena (genera valor: educación, vivienda, negocio) de deuda mala (consumo: tarjetas, préstamos personales). Prioriza pagar deudas con interés alto (>20%) antes de invertir.</string>
    <string name="tip_inflation_title">Inflación en Guatemala</string>
    <string name="tip_inflation_category">Economía</string>
    <string name="tip_inflation_content">La inflación erosiona el poder adquisitivo (~4-6% anual en GT). Tu dinero debe crecer por encima de la inflación. Mantener efectivo bajo el colchón pierde valor. Invierte para preservar y crecer.</string>
    <string name="tip_automation_title">Automatización</string>
    <string name="tip_automation_category">Hábitos</string>
    <string name="tip_automation_content">Automatiza tu ahorro: configura transferencias automáticas al recibir tu salario. \"Págate a ti primero\". Usa débitos automáticos para metas, inversiones y pagos de deuda. Elimina la decisión emocional.</string>
    <string name="tip_zero_budget_title">Presupuesto Base Cero</string>
    <string name="tip_zero_budget_category">Presupuesto</string>
    <string name="tip_zero_budget_content">Asigna cada quetzal a una categoría antes de que empiece el mes: Ingresos - Gastos - Ahorro = 0. Si sobra, destina a metas. Si falta, ajusta gastos. Revisa semanalmente y corrige desviaciones.</string>
    <string name="tip_asset_protection_title">Protección Patrimonial</string>
    <string name="tip_asset_protection_category">Seguros</string>
    <string name="tip_asset_protection_content">Protege lo construido: seguro médico (gastos catastróficos), seguro de vida (si tienes dependientes), seguro de vivienda/auto. En Guatemala, evalúa seguros de cooperativas y bancas vs aseguradoras tradicionales.</string>
</resources>
